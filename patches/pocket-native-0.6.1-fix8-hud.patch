+impl System {
+    /// the share of instructions the interpreter ran since the last call, in
+    /// percent, for the frontend's periodic log line.
+    pub fn interpreted_share(&mut self) -> f64 {
+        let fallbacks = self.recompiled.as_ref().map_or(0, |library| library.fallbacks());
+        let interpreted = self.interpreted_instructions + fallbacks;
+        let total = interpreted + self.recompiled_instructions;
+        let (last_interpreted, last_total) = std::mem::replace(&mut self.interp_counted, (interpreted, total));
+        let ran = total.saturating_sub(last_total).max(1);
+        interpreted.saturating_sub(last_interpreted) as f64 * 100.0 / ran as f64
+    }
+}
+
+/// with ZAKURO_INTERP_STATS, the busiest addresses the interpreter ran so
+/// far, logged while the game runs: a game stopped by a signal never gets to
+/// the report its end prints.
+pub fn log_interpreted_busiest(count: usize) {
+    if let Some(counts) = INTERPRETED.lock().unwrap().as_ref() {
+        let mut busiest: Vec<_> = counts.iter().map(|(&address, &n)| (address, n)).collect();
+        busiest.sort_by_key(|&(_, n)| std::cmp::Reverse(n));
+        let line: Vec<String> = busiest.into_iter().take(count).map(|(address, n)| format!("{address:08X}x{n}")).collect();
+        log::info!("interpreted busiest: {}", line.join(" "));
+    }
+}
