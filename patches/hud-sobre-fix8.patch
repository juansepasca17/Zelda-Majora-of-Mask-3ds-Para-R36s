+/// the one-screen HUD: pieces of the bottom screen, left, top, width and
+/// height in its own pixels, each drawn over an area of the layout, while
+/// the layout shows the top screen alone (the game's hud.txt).
+static HUD: std::sync::RwLock<Vec<([i32; 4], [i32; 4])>> = std::sync::RwLock::new(Vec::new());
+
+/// sets the one-screen HUD's pieces, none to turn it off.
+pub fn set_hud(pieces: Vec<([i32; 4], [i32; 4])>) {
