+}
+
+/// whether the one-screen HUD has pieces to draw.
+pub fn hud_active() -> bool {
+    HUD.read().is_ok_and(|hud| !hud.is_empty())
+}
+
+/// points of the bottom screen, x and y in its pixels, and the color each
+/// has while it shows the game's HUD, for telling that apart from menus.
+static HUD_CHECKS: std::sync::RwLock<Vec<([u16; 2], [u8; 3])>> = std::sync::RwLock::new(Vec::new());
+/// what the bottom screen showed when last looked at: 0 not known, 1 the
+/// HUD, 2 nothing (black), 3 something else, a menu.
+static HUD_SEEN: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(0);
+
+pub fn set_hud_checks(checks: Vec<([u16; 2], [u8; 3])>) {
+    if let Ok(mut held) = HUD_CHECKS.write() {
+        *held = checks;
+    }
+}
+
+pub fn hud_checks() -> Vec<([u16; 2], [u8; 3])> {
+    HUD_CHECKS.read().map(|checks| checks.clone()).unwrap_or_default()
+}
+
+/// what the bottom screen showed when last looked at, as HUD_SEEN.
+pub fn hud_seen() -> u8 {
+    HUD_SEEN.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// tells from the bottom screen's picture, RGBA rows from the top at scale
+/// times its size, whether it shows the HUD (1), nothing (2) or else (3).
+pub fn note_hud_seen(pixels: &[u8], scale: u32, checks: &[([u16; 2], [u8; 3])]) -> u8 {
+    let (scale, width) = (scale.max(1) as usize, 320 * scale.max(1) as usize);
+    let at = |x: usize, y: usize| -> Option<[u8; 3]> {
+        let offset = ((y * scale) * width + x * scale) * 4;
+        pixels.get(offset..offset + 3).map(|p| [p[0], p[1], p[2]])
+    };
+    let matched = checks
+        .iter()
+        .filter(|([x, y], want)| at(*x as usize, *y as usize).is_some_and(|got| got.iter().zip(want).map(|(a, b)| (*a as i32 - *b as i32).abs()).sum::<i32>() <= 48))
+        .count();
