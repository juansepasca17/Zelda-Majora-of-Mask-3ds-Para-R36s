+
+/// tells from the bottom screen's picture, RGBA rows from the top at scale
+/// times its size, whether it shows the HUD (1), nothing (2) or else (3).
+pub fn note_hud_seen(pixels: &[u8], scale: u32, checks: &[([u16; 2], [u8; 3])]) -> u8 {
+    let (scale, width) = (scale.max(1) as usize, 320 * scale.max(1) as usize);
+    let at = |x: usize, y: usize| -> Option<[u8; 3]> {
+        let offset = ((y * scale) * width + x * scale) * 4;
+        pixels.get(offset..offset + 3).map(|p| [p[0], p[1], p[2]])
+    };
+    let matched = checks
+        .iter()
+        .filter(|([x, y], want)| at(*x as usize, *y as usize).is_some_and(|got| got.iter().zip(want).map(|(a, b)| (*a as i32 - *b as i32).abs()).sum::<i32>() <= 48))
+        .count();
+    let seen = if !checks.is_empty() && matched * 4 >= checks.len() * 3 {
+        1
+    } else if (0..8).all(|i| (0..6).all(|j| at(20 + i * 40, 20 + j * 40).is_some_and(|p| p.iter().all(|c| *c < 12)))) {
+        2
+    } else {
+        3
+    };
+    if HUD_SEEN.swap(seen, std::sync::atomic::Ordering::Relaxed) != seen {
+        let said = ["?", "the HUD", "nothing", "something else"][seen as usize];
+        log::info!("one-screen HUD: the bottom screen shows {said}");
+        // a picture of it, 30 a run at most, for telling a talk from a menu
+        // later: data/shots/NN-what.ppm
+        static SHOTS: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+        let number = SHOTS.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        if number < 30 && seen != 2 {
+            if let Some(data) = std::env::var_os("ZAKURO_DATA") {
+                let dir = std::path::Path::new(&data).join("shots");
+                let height = 240 * scale;
+                let mut ppm = format!("P6\n{width} {height}\n255\n").into_bytes();
+                ppm.extend(pixels.chunks(4).take(width * height).flat_map(|pixel| pixel[..3].to_vec()));
+                let name = format!("{number:02}-{}.ppm", said.replace(' ', "-"));
+                let _ = std::fs::create_dir_all(&dir).and_then(|()| std::fs::write(dir.join(name), ppm));
+            }
+        }
+    }
+    seen
+}
 
