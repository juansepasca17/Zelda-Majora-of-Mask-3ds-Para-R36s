+        1
+    } else if (0..8).all(|i| (0..6).all(|j| at(20 + i * 40, 20 + j * 40).is_some_and(|p| p.iter().all(|c| *c < 12)))) {
+        2
+    } else {
+        3
+    };
+    if HUD_SEEN.swap(seen, std::sync::atomic::Ordering::Relaxed) != seen {
+        log::info!("one-screen HUD: the bottom screen shows {}", ["?", "the HUD", "nothing", "something else"][seen as usize]);
+    }
+    seen
